#!/bin/bash
# omarchy-todo: CLI and summon helper for Omarchy To-Do List Plugin

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/todo"
STORAGE_FILE="$STATE_DIR/todo-items.json"
LEGACY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/todo-items.json"

(
  umask 077
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  if [[ ! -f "$STORAGE_FILE" && -f "$LEGACY_FILE" ]]; then
    cp -f "$LEGACY_FILE" "$STORAGE_FILE" 2>/dev/null || true
  fi
  if [[ ! -f "$STORAGE_FILE" ]]; then
    echo "[]" > "$STORAGE_FILE"
  fi
  chmod 600 "$STORAGE_FILE" 2>/dev/null || true
  if [[ -f "$LEGACY_FILE" ]]; then
    chmod 600 "$LEGACY_FILE" 2>/dev/null || true
  fi
)

cmd="${1:-toggle}"

case "$cmd" in
  toggle)
    omarchy-shell shell toggle ciphersar.todo "{}"
    ;;
  open|show|summon|todo)
    omarchy-shell shell summon ciphersar.todo '{"tab":"todo"}'
    omarchy-shell shell call ciphersar.todo switchTab todo >/dev/null 2>&1 || true
    ;;
  history)
    omarchy-shell shell summon ciphersar.todo '{"tab":"history"}'
    omarchy-shell shell call ciphersar.todo switchTab history >/dev/null 2>&1 || true
    ;;
  close|hide)
    omarchy-shell shell hide ciphersar.todo
    ;;
  add)
    shift
    task="$*"
    if [[ -z "$task" ]]; then
      echo "Usage: omarchy-todo add <task description>" >&2
      exit 1
    fi
    now_ms=$(date +%s%3N)
    new_id="todo_${now_ms}_$RANDOM"
    tmp_file=$(mktemp "$STATE_DIR/.tmp.XXXXXX")
    chmod 600 "$tmp_file"
    jq --arg id "$new_id" --arg text "$task" --argjson now "$now_ms" '
      [{ id: $id, text: $text, completed: false, createdAt: $now, completedAt: null }] + .
    ' "$STORAGE_FILE" > "$tmp_file" && mv -f "$tmp_file" "$STORAGE_FILE"
    chmod 600 "$STORAGE_FILE"
    echo "Added to-do: $task"
    ;;
  list)
    jq -r '.[] | select(.completed == false) | "- [ ] \(.text)"' "$STORAGE_FILE"
    ;;
  -h|--help|help)
    cat <<EOF
Usage: omarchy-todo [command]

Commands:
  toggle          Toggle Quake-style drop-down console (default)
  open            Open Quake-style drop-down console
  close           Close drop-down console
  history         Open drop-down console to History tab
  add <text>      Add a new to-do item directly from CLI
  list            List active to-dos
  help            Show this help message
EOF
    ;;
  *)
    # Treat arbitrary argument as task to add if more than one word or toggle
    if (( $# > 1 )); then
      "$0" add "$@"
    else
      omarchy-shell shell toggle ciphersar.todo "{}"
    fi
    ;;
esac
